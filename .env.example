# Copy to .env.local for local development. NEVER commit real values.
# On Vercel, add the same two variables under Project Settings -> Environment Variables.

# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password. Keep the "postgres.<project-ref>" username.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres

# Any long random string (32+ characters). Generate one with:  openssl rand -base64 48
SESSION_SECRET=
